{
  "manifest_version": 3,
  "name": "Coletor de Vagas do LinkedIn",
  "version": "1.4.1",
  "description": "Organiza vagas de uma busca do LinkedIn e exporta CSV e JSON.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
    "js": ["bridge.js"]
  }],
  "action": {
    "default_title": "Coletar vagas",
    "default_popup": "popup.html"
  }
}
